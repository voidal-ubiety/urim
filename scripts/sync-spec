#!/usr/bin/env python3
# SPDX-License-Identifier: Apache-2.0
"""Keep spec/ an exact copy of the upstream decision-contract-spec working tree.

    scripts/sync-spec          check (verify.sh runs this); exit 1 on any mismatch
    scripts/sync-spec --write  copy the upstream files in and re-record spec/SOURCE.json

Copied: SPEC.md, CHANGELOG.md and everything under examples/. spec/README.md and
spec/SOURCE.json belong to this repo. Nothing else may be in spec/.

The check has two parts:
  1. every repo copy matches the sha256 recorded in spec/SOURCE.json, with no missing or
     extra files. This works offline and in CI.
  2. if the upstream tree is present (URIM_SPEC_SOURCE, default ../decision-contract-spec),
     its files match the same record, so a newer upstream draft fails the check until it
     is re-synced. If upstream is absent, this part prints SKIP and does not fail.
The upstream tree is read-only: this script never writes to it.
"""
from __future__ import annotations

import hashlib
import json
import os
import shutil
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
SPEC = ROOT / "spec"
RECORD = SPEC / "SOURCE.json"
OWN = {"README.md", "SOURCE.json"}
SOURCE = Path(os.environ.get("URIM_SPEC_SOURCE", ROOT.parent / "decision-contract-spec")).resolve()


def sha(p: Path) -> str:
    return hashlib.sha256(p.read_bytes()).hexdigest()


def upstream_files() -> list[str]:
    files = ["SPEC.md", "CHANGELOG.md"]
    files += sorted(p.relative_to(SOURCE).as_posix() for p in (SOURCE / "examples").rglob("*") if p.is_file())
    return files


def repo_files() -> set[str]:
    return {p.relative_to(SPEC).as_posix() for p in SPEC.rglob("*") if p.is_file()} - OWN


def write() -> int:
    if not (SOURCE / "SPEC.md").is_file():
        print(f"sync-spec: upstream not found at {SOURCE} (set URIM_SPEC_SOURCE)", file=sys.stderr)
        return 2
    files = upstream_files()
    for rel in sorted(repo_files() - set(files)):
        (SPEC / rel).unlink()
    for rel in files:
        (SPEC / rel).parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(SOURCE / rel, SPEC / rel)
    record = {
        "comment": "Written by scripts/sync-spec --write. sha256 of each file copied from upstream decision-contract-spec.",
        "source": "decision-contract-spec (working tree; not a git repo, so there is no commit to pin)",
        "files": {rel: sha(SPEC / rel) for rel in files},
    }
    RECORD.write_text(json.dumps(record, indent=2) + "\n", encoding="utf-8")
    print(f"sync-spec: copied {len(files)} files from {SOURCE}")
    return 0


def check() -> int:
    problems: list[str] = []
    recorded: dict[str, str] = json.loads(RECORD.read_text(encoding="utf-8"))["files"]
    have = repo_files()
    for rel in sorted(set(recorded) - have):
        problems.append(f"spec/{rel} is missing (recorded in spec/SOURCE.json)")
    for rel in sorted(have - set(recorded)):
        problems.append(f"spec/{rel} is not an upstream copy (spec/ holds only copies plus README.md and SOURCE.json)")
    for rel in sorted(have & set(recorded)):
        if sha(SPEC / rel) != recorded[rel]:
            problems.append(f"spec/{rel} was edited here (sha256 differs from spec/SOURCE.json); edit upstream and re-sync")
    if (SOURCE / "SPEC.md").is_file():
        up = upstream_files()
        for rel in sorted(set(up) - set(recorded)):
            problems.append(f"upstream {rel} is new and not copied; run scripts/sync-spec --write")
        for rel in sorted(set(recorded) - set(up)):
            problems.append(f"upstream {rel} was removed; run scripts/sync-spec --write")
        for rel in sorted(set(up) & set(recorded)):
            if sha(SOURCE / rel) != recorded[rel]:
                problems.append(f"spec/{rel} is stale: upstream changed; run scripts/sync-spec --write")
        upstream = "matches upstream"
    else:
        upstream = f"SKIP upstream comparison ({SOURCE} not present)"
    for p in problems:
        print(f"sync-spec: {p}", file=sys.stderr)
    if problems:
        return 1
    print(f"sync-spec OK: {len(recorded)} files match spec/SOURCE.json; {upstream}")
    return 0


if __name__ == "__main__":
    args = sys.argv[1:]
    if args == ["--write"]:
        sys.exit(write())
    if args:
        print(__doc__.strip().splitlines()[2], file=sys.stderr)
        sys.exit(2)
    sys.exit(check())
