#!/usr/bin/env python3
"""Generate each port's schema module from schema/urim-0.2.json (the single source).

    scripts/gen-schema          write the three generated files
    scripts/gen-schema --check  exit 1 if any generated file is stale (verify.sh runs this)

Every message fragment ("must be <desc>") is computed here, so the three ports print the
same bytes. Named types become named constants, in dependency order.
"""
from __future__ import annotations

import json
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
SOURCE = ROOT / "schema" / "urim-0.2.json"
OUT = {
    "js": ROOT / "packages/js/src/schema.gen.ts",
    "py": ROOT / "packages/python/src/urim/schema_gen.py",
    "rs": ROOT / "packages/rust/src/schema_gen.rs",
}
HEADER = "Generated by scripts/gen-schema from schema/urim-0.2.json. Do not edit; run scripts/gen-schema."


def num(x: float) -> str:
    return str(int(x)) if float(x).is_integer() else repr(float(x))


def desc(node: dict, data: dict) -> str:
    if "ref" in node:
        return desc(data["types"][node["ref"]], data)
    if "desc" in node:
        return node["desc"]
    k = node["k"]
    if k == "str":
        return data["formats"][node["fmt"]]
    if k == "int":
        return f"an integer >= {node['min']}" if "min" in node else "an integer"
    if k == "num":
        if "min" not in node:
            return "a number"
        lo = "(" if node.get("min_open") else "["
        hi = ")" if node.get("max_open") else "]"
        return f"a number in {lo}{num(node['min'])}, {num(node['max'])}{hi}"
    if k == "bool":
        return "true or false"
    if k == "enum":
        v = node["values"]
        return v[0] if len(v) == 1 else "one of " + ", ".join(v)
    if k == "list":
        m = node.get("min", 0)
        return "a list" if m == 0 else "a non-empty list" if m == 1 else f"a list of at least {m} items"
    if k == "map":
        return "a non-empty mapping" if node.get("min", 0) >= 1 else "a mapping"
    if k == "obj":
        return "a mapping"
    if k == "one":
        return "a mapping with exactly one of " + ", ".join(f["name"] for f in node["keys"])
    if k == "opaque":
        return "a non-empty mapping"
    if k == "alt":
        return " or ".join(desc(o, data) for o in node["options"])
    raise SystemExit(f"unknown node kind {k!r}")


def refs(node: object) -> list[str]:
    if isinstance(node, dict):
        out = [node["ref"]] if "ref" in node else []
        for v in node.values():
            out += refs(v)
        return out
    if isinstance(node, list):
        return [r for v in node for r in refs(v)]
    return []


def order(types: dict) -> list[str]:
    done: list[str] = []
    def visit(name: str, path: tuple[str, ...]) -> None:
        if name in done:
            return
        if name in path:
            raise SystemExit(f"schema type cycle: {' -> '.join(path + (name,))}")
        for r in refs(types[name]):
            visit(r, path + (name,))
        done.append(name)
    for name in types:
        visit(name, ())
    return done


def const(name: str) -> str:
    return name.upper()


def q(s: str) -> str:
    return json.dumps(s, ensure_ascii=False)


FMT_RS = {"string": "String", "expr": "Expr", "id": "Id", "target_id": "TargetId", "capability_path": "CapabilityPath",
          "semver": "Semver", "semver_range": "SemverRange", "protocol_version": "ProtocolVersion", "hash": "Hash",
          "integrity": "Integrity", "timestamp": "Timestamp", "x_key": "XKey", "confidence_ref": "ConfidenceRef"}


class Emit:
    def __init__(self, data: dict, lang: str):
        self.data, self.lang = data, lang

    def fields(self, fs: list) -> str:
        items = [self.field(f) for f in fs]
        if self.lang == "js":
            return "[" + ", ".join(items) + "]"
        if self.lang == "py":
            return "(" + "".join(i + ", " for i in items) + ")"
        return "&[" + ", ".join(items) + "]"

    def field(self, f: dict) -> str:
        n, t, r = q(f["name"]), self.node(f["type"]), f.get("req", False)
        if self.lang == "js":
            return f"{{ name: {n}, node: {t}, req: {str(r).lower()} }}"
        if self.lang == "py":
            return f"Field({n}, {t}, req={r})"
        return f"Field {{ name: {n}, node: {self.ref(t)}, req: {str(r).lower()} }}"

    def ref(self, t: str) -> str:
        # Rust: a named static is referenced, an inline node is promoted to a static.
        return t if t.startswith("&") else "&" + t

    def pairs(self, d: dict) -> str:
        if self.lang == "js":
            return "[" + ", ".join(f"[{q(k)}, {q(v)}]" for k, v in d.items()) + "]"
        if self.lang == "py":
            return "(" + "".join(f"({q(k)}, {q(v)}), " for k, v in d.items()) + ")"
        return "&[" + ", ".join(f"({q(k)}, {q(v)})" for k, v in d.items()) + "]"

    def strs(self, xs: list) -> str:
        if self.lang == "js":
            return "[" + ", ".join(q(x) for x in xs) + "]"
        if self.lang == "py":
            return "(" + "".join(q(x) + ", " for x in xs) + ")"
        return "&[" + ", ".join(q(x) for x in xs) + "]"

    def node(self, n: dict) -> str:
        L = self.lang
        if "ref" in n:
            return ("&" if L == "rs" else "") + const(n["ref"])
        k, d = n["k"], q(desc(n, self.data))
        if k == "str":
            f = n["fmt"]
            return {"js": f'{{ k: "str", fmt: {q(f)}, desc: {d} }}', "py": f"Str({q(f)}, {d})",
                    "rs": f"Node::Str {{ fmt: Fmt::{FMT_RS[f]}, desc: {d} }}"}[L]
        if k == "int":
            m = n.get("min")
            return {"js": f'{{ k: "int", min: {"null" if m is None else str(m) + "n"}, desc: {d} }}',
                    "py": f"Int({m}, {d})",
                    "rs": f"Node::Int {{ min: {'None' if m is None else f'Some({m})'}, desc: {d} }}"}[L]
        if k == "num":
            lo, hi = n.get("min"), n.get("max")
            mo, xo = n.get("min_open", False), n.get("max_open", False)
            f = lambda x, none: none if x is None else repr(float(x))
            return {"js": f'{{ k: "num", min: {f(lo, "null")}, max: {f(hi, "null")}, minOpen: {str(mo).lower()}, maxOpen: {str(xo).lower()}, desc: {d} }}',
                    "py": f"Num({f(lo, 'None')}, {f(hi, 'None')}, {d}, min_open={mo}, max_open={xo})",
                    "rs": "Node::Num { " + f"min: {'None' if lo is None else f'Some({float(lo)!r})'}, max: {'None' if hi is None else f'Some({float(hi)!r})'}, min_open: {str(mo).lower()}, max_open: {str(xo).lower()}, desc: {d} " + "}"}[L]
        if k == "bool":
            return {"js": f'{{ k: "bool", desc: {d} }}', "py": f"Bool({d})", "rs": f"Node::Bool {{ desc: {d} }}"}[L]
        if k == "enum":
            v = self.strs(n["values"])
            return {"js": f'{{ k: "enum", values: {v}, desc: {d} }}', "py": f"Enum({v}, {d})",
                    "rs": f"Node::Enum {{ values: {v}, desc: {d} }}"}[L]
        if k == "list":
            it, m, u = self.node(n["items"]), n.get("min", 0), n.get("unique", False)
            return {"js": f'{{ k: "list", items: {it}, min: {m}, unique: {str(u).lower()}, desc: {d} }}',
                    "py": f"List({it}, {m}, {d}, unique={u})",
                    "rs": f"Node::List {{ items: {self.ref(it)}, min: {m}, unique: {str(u).lower()}, desc: {d} }}"}[L]
        if k == "map":
            kf, v, m, e = n["key"], self.node(n["value"]), n.get("min", 0), self.fields(n.get("entries", []))
            return {"js": f'{{ k: "map", key: {q(kf)}, value: {v}, min: {m}, entries: {e}, desc: {d} }}',
                    "py": f"Map({q(kf)}, {v}, {m}, {e}, {d})",
                    "rs": f"Node::Map {{ key: Fmt::{FMT_RS[kf]}, value: {self.ref(v)}, min: {m}, entries: {e}, desc: {d} }}"}[L]
        if k == "obj":
            fs, ext, rm = self.fields(n["fields"]), n.get("ext", False), self.pairs(n.get("removed", {}))
            tag = n.get("tag")
            if L == "js":
                t = "null" if tag is None else "{ field: " + q(tag["field"]) + ", variants: [" + ", ".join(
                    f"[{q(v)}, {self.fields(f)}]" for v, f in tag["variants"].items()) + "] }"
                return f'{{ k: "obj", fields: {fs}, ext: {str(ext).lower()}, tag: {t}, removed: {rm}, desc: {d} }}'
            if L == "py":
                t = "None" if tag is None else f"Tag({q(tag['field'])}, (" + "".join(
                    f"({q(v)}, {self.fields(f)}), " for v, f in tag["variants"].items()) + "))"
                return f"Obj({fs}, {t}, {rm}, {d}, ext={ext})"
            t = "None" if tag is None else "Some(Tag { field: " + q(tag["field"]) + ", variants: &[" + ", ".join(
                f"({q(v)}, {self.fields(f)})" for v, f in tag["variants"].items()) + "] })"
            return f"Node::Obj {{ fields: {fs}, ext: {str(ext).lower()}, tag: {t}, removed: {rm}, desc: {d} }}"
        if k == "one":
            ks, fb = self.fields(n["keys"]), self.pairs(n.get("forbid", {}))
            return {"js": f'{{ k: "one", keys: {ks}, forbid: {fb}, desc: {d} }}', "py": f"One({ks}, {fb}, {d})",
                    "rs": f"Node::One {{ keys: {ks}, forbid: {fb}, desc: {d} }}"}[L]
        if k == "alt":
            os_ = [self.node(o) for o in n["options"]]
            if L == "js":
                return f'{{ k: "alt", options: [{", ".join(os_)}], desc: {d} }}'
            if L == "py":
                return f"Alt(({''.join(o + ', ' for o in os_)}), {d})"
            if any(o.startswith("&") for o in os_):
                raise SystemExit("alt options must be inline nodes, not refs")
            return f"Node::Alt {{ options: &[{', '.join(os_)}], desc: {d} }}"
        if k == "opaque":
            return {"js": f'{{ k: "opaque", desc: {d} }}', "py": f"Opaque({d})", "rs": f"Node::Opaque {{ desc: {d} }}"}[L]
        raise SystemExit(f"unknown node kind {k!r}")


def render(data: dict, lang: str) -> str:
    e = Emit(data, lang)
    names = order(data["types"])
    proto, exp, emu = data["protocol"], data["experimental_question_types"], data["emulations"]
    if lang == "js":
        out = [f"// {HEADER}", "// Implements: C-095..C-099 (schema data)", 'import type { Fmt } from "./formats.js";', 'import type { Node } from "./node.js";', "",
               f"export const PROTOCOL = {q(proto)};",
               f"export const EXPERIMENTAL_QUESTION_TYPES: readonly string[] = {e.strs(exp)};",
               "export const EMULATIONS: ReadonlyMap<string, readonly string[]> = new Map([" + ", ".join(
                   f"[{q(k)}, {e.strs(v)}]" for k, v in emu.items()) + "]);",
               "export const FORMATS: Readonly<Record<Fmt, string>> = {",
               *[f"  {k}: {q(v)}," for k, v in data["formats"].items()], "};"]
        out += [f"export const {const(n)}: Node = {e.node(data['types'][n])};" for n in names]
        return "\n".join(out) + "\n"
    if lang == "py":
        out = [f'"""{HEADER}', "", 'Implements: C-095..C-099 (schema data)', '"""', "", "from __future__ import annotations", "",
               "from urim.node import Alt, Bool, Enum, Field, Fmt, Int, List, Map, Node, Num, Obj, One, Opaque, Str, Tag", "",
               f"PROTOCOL = {q(proto)}", f"EXPERIMENTAL_QUESTION_TYPES: tuple[str, ...] = {e.strs(exp)}",
               "EMULATIONS: dict[str, tuple[str, ...]] = {" + ", ".join(f"{q(k)}: {e.strs(v)}" for k, v in emu.items()) + "}",
               "FORMATS: dict[Fmt, str] = {", *[f"    {q(k)}: {q(v)}," for k, v in data["formats"].items()], "}"]
        out += [f"{const(n)}: Node = {e.node(data['types'][n])}" for n in names]
        return "\n".join(out) + "\n"
    out = [f"//! {HEADER}", "//!", "//! Implements: C-095..C-099 (schema data)", "",
           "use crate::schema::{Field, Fmt, Node, Tag};", "",
           f"pub(crate) const PROTOCOL: &str = {q(proto)};",
           f"pub(crate) const EXPERIMENTAL_QUESTION_TYPES: &[&str] = {e.strs(exp)};",
           "pub(crate) const EMULATIONS: &[(&str, &[&str])] = &[" + ", ".join(f"({q(k)}, {e.strs(v)})" for k, v in emu.items()) + "];",
           "/// The description of a string format, for `must be <desc>`.",
           "pub(crate) const fn format_desc(fmt: Fmt) -> &'static str {", "    match fmt {",
           *[f"        Fmt::{FMT_RS[k]} => {q(v)}," for k, v in data["formats"].items()], "    }", "}"]
    out += [f"pub(crate) static {const(n)}: Node = {e.node(data['types'][n])};" for n in names]
    return "\n".join(out) + "\n"


def main() -> int:
    data = json.loads(SOURCE.read_text(encoding="utf-8"))
    check = sys.argv[1:] == ["--check"]
    stale = []
    for lang, path in OUT.items():
        text = render(data, lang)
        if check:
            if not path.exists() or path.read_text(encoding="utf-8") != text:
                stale.append(str(path.relative_to(ROOT)))
        else:
            path.write_text(text, encoding="utf-8")
    if stale:
        print("gen-schema: stale (run scripts/gen-schema): " + ", ".join(stale), file=sys.stderr)
        return 1
    print("gen-schema: " + ("up to date" if check else "wrote " + ", ".join(str(p.relative_to(ROOT)) for p in OUT.values())))
    return 0


if __name__ == "__main__":
    sys.exit(main())
