#!/usr/bin/env python3
# SPDX-License-Identifier: Apache-2.0
"""Generate .github/CODEOWNERS from config/people.yaml (the one swappable people config).

    scripts/gen-codeowners --check   fail if .github/CODEOWNERS differs (verify.sh)
    scripts/gen-codeowners --write   rewrite it

Placeholder handles (<...>) are allowed but reported, so CODEOWNERS is inert until David
sets real GitHub usernames. Exit 0 ok, 1 drift or bad config, 2 usage.
"""
from __future__ import annotations

import sys
from pathlib import Path

import yaml

ROOT = Path(__file__).resolve().parent.parent
CONFIG = ROOT / "config" / "people.yaml"
OUT = ROOT / ".github" / "CODEOWNERS"


def render(cfg: dict) -> str:
    handles = {}
    for m in cfg["maintainers"]:
        gh = m["github"]
        handles[m["id"]] = gh if gh.startswith("<") else "@" + gh.lstrip("@")
    lines = [
        "# Generated by scripts/gen-codeowners from config/people.yaml. Do not edit.",
        "# GitHub: the last matching pattern takes precedence.",
        "",
    ]
    for rule in cfg["codeowners"]:
        unknown = [o for o in rule["owners"] if o not in handles]
        if unknown:
            raise SystemExit(f"gen-codeowners: unknown owner id(s) {unknown} for {rule['pattern']}")
        if rule.get("note"):
            lines.append(f"# {rule['note']}")
        lines.append(" ".join([rule["pattern"], *(handles[o] for o in rule["owners"])]))
    return "\n".join(lines) + "\n"


def main(argv: list[str]) -> int:
    if argv not in (["--check"], ["--write"]):
        print(__doc__.strip().splitlines()[2], file=sys.stderr)
        return 2
    cfg = yaml.safe_load(CONFIG.read_text(encoding="utf-8"))
    text = render(cfg)
    placeholders = sorted({m["github"] for m in cfg["maintainers"] if m["github"].startswith("<")})
    note = f" (placeholder handles: {', '.join(placeholders)})" if placeholders else ""
    if argv == ["--write"]:
        OUT.parent.mkdir(exist_ok=True)
        OUT.write_text(text, encoding="utf-8")
        print(f"gen-codeowners: wrote {OUT.relative_to(ROOT)}{note}")
        return 0
    if not OUT.exists() or OUT.read_text(encoding="utf-8") != text:
        print("gen-codeowners: .github/CODEOWNERS is out of date; run scripts/gen-codeowners --write",
              file=sys.stderr)
        return 1
    print(f"gen-codeowners OK: .github/CODEOWNERS matches config/people.yaml{note}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
