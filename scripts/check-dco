#!/usr/bin/env python3
# SPDX-License-Identifier: Apache-2.0
"""DCO check (D-32, CONTRIBUTING.md "Sign-off").

    scripts/check-dco [REV-RANGE]     default: every commit reachable from HEAD

Each non-merge commit needs a `Signed-off-by: Name <email>` trailer that matches its
author. A human must add it (`git commit -s`). An agent must not sign off for a person.
The commits from before D-32 fail until David's history rewrite (RELEASE-RUNBOOK §3a).
That failure is expected, so this runs only in `scripts/verify.sh --release`.
Exit 0 all signed, 1 some unsigned.
"""
from __future__ import annotations

import subprocess
import sys

SEP = "\x1e"


def main(argv: list[str]) -> int:
    rev = argv[0] if argv else "HEAD"
    log = subprocess.run(
        ["git", "log", "--no-merges", f"--format=%H%x1f%an <%ae>%x1f%(trailers:key=Signed-off-by,valueonly,separator=%x1d){SEP}", rev],
        capture_output=True, text=True, check=True,
    ).stdout
    bad = []
    commits = [c.strip("\n") for c in log.split(SEP) if c.strip()]
    for c in commits:
        sha, author, trailers = c.split("\x1f")
        signers = [t.strip() for t in trailers.split("\x1d") if t.strip()]
        if author not in signers:
            bad.append(f"{sha[:10]} {author}: " + (f"signed by {signers}, not the author" if signers else "no Signed-off-by"))
    for b in bad:
        print(f"check-dco: {b}", file=sys.stderr)
    if bad:
        print(f"check-dco: {len(bad)}/{len(commits)} commits lack the author's Signed-off-by", file=sys.stderr)
        return 1
    print(f"check-dco OK: {len(commits)} commits signed off by their authors")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
