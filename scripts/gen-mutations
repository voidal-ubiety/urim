def mutate(base: str, ops: dict[tuple, object]) -> dict:
    doc = copy.deepcopy(BASE[base])
    for path, value in ops.items():
        parent = doc
        for seg in path[:-1]:
            parent = parent[seg]
        if value is DEL:
            del parent[path[-1]]
        else:
            parent[path[-1]] = value
    return doc


def render(name: str, cid: str, base: str, ops: dict[tuple, object], seal: bool) -> str:
    doc = mutate(base, ops)
    if base == "l" and seal and "integrity" in doc:
        doc["integrity"] = integrity_of({k: v for k, v in doc.items() if k != "integrity"})
    src = "spec/examples/incident-triage.decision.yaml" if base == "c" else "fixtures/valid/full.lock"
    change = "; ".join(".".join(map(str, p)) + (" deleted" if v is DEL else " = " + (".inf" if v is INF else json.dumps(v, ensure_ascii=True))) for p, v in ops.items())
    head = f"# {cid}: generated by scripts/gen-mutations; do not edit.\n# {src} with {change[:300]}\n"
    body = json.dumps(doc, indent=1, ensure_ascii=False)
    assert body.count("Infinity") == sum(v is INF for v in ops.values())
    return head + body.replace("Infinity", ".inf") + "\n"


def files() -> dict[str, str]:
    out: dict[str, str] = {}
    for name, cid, base, ops, seal in M:
        fname = f"{name}.{'lock' if base == 'l' else 'yaml'}"
        assert fname not in out, fname
        out[fname] = render(name, cid, base, ops, seal)
    return out


def main(argv: list[str]) -> int:
    want = files()
    if argv[1:] == ["--check"]:
        have = {p.name for p in OUT.iterdir()} if OUT.is_dir() else set()
        bad = sorted(n for n in want if n not in have or (OUT / n).read_text(encoding="utf-8") != want[n])
        bad += sorted(have - set(want))
        for n in bad:
            print(f"fixtures/mutations/{n}: missing, stale or not generated (run scripts/gen-mutations)", file=sys.stderr)
        return 1 if bad else 0
    if argv[1:]:
        print(__doc__, file=sys.stderr)
        return 2
    OUT.mkdir(exist_ok=True)
    for p in OUT.iterdir():
        p.unlink()
    for n, text in want.items():
        (OUT / n).write_text(text, encoding="utf-8")
    print(f"wrote {len(want)} files to fixtures/mutations/")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
