#!/usr/bin/env python3
# SPDX-License-Identifier: Apache-2.0
"""Supply-chain tripwire: the locked runtime dependency closure must equal config/deps-allowlist.json.

    scripts/check-deps            check (run by scripts/verify.sh)
    scripts/check-deps --write    rewrite the allowlist from the lockfiles (review the diff!)

For each port it reads the lockfile, never the network, and finds the runtime closure (what
a user of the published package installs): JS from package-lock.json (entries not marked
dev), Python from uv.lock (the dependency closure of `urim`, extras and groups excluded),
and Rust from `cargo metadata --locked --offline` (normal and build edges from `urim`).
Each entry is name + version + the lockfile's checksum, so a new package, a version bump or
a re-published tarball with a different hash fails the check.

It also reports, and allowlists, the Rust crates in that closure that run code at build
time (build scripts, proc-macros), and fails if any npm package in the whole lock
(dev included) declares an install script. Install scripts are also disabled by
`npm ci --ignore-scripts`.

What it does NOT do: read the code, judge whether a version is safe, or catch a malicious
version that was already in the lock when the allowlist was written. A human reviews every
`--write` diff (CONTRIBUTING.md "Dependency policy"). See SECURITY.md "Supply chain".
Exit 0 OK, 1 mismatch, 2 tool or file missing.
"""
from __future__ import annotations

import json
import subprocess
import sys
import tomllib
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
ALLOW = ROOT / "config/deps-allowlist.json"


def js() -> dict[str, dict[str, object]]:
    lock = json.loads((ROOT / "packages/js/package-lock.json").read_text(encoding="utf-8"))
    out: dict[str, dict[str, object]] = {}
    for key, pkg in lock["packages"].items():
        if key and not pkg.get("dev"):
            out[key.removeprefix("node_modules/")] = {"version": pkg["version"], "integrity": pkg["integrity"]}
    return dict(sorted(out.items()))


def js_install_scripts() -> list[str]:
    lock = json.loads((ROOT / "packages/js/package-lock.json").read_text(encoding="utf-8"))
    return sorted(k for k, p in lock["packages"].items() if k and p.get("hasInstallScript"))


def python() -> dict[str, dict[str, object]]:
    lock = tomllib.loads((ROOT / "packages/python/uv.lock").read_text(encoding="utf-8"))
    pkgs = {p["name"]: p for p in lock["package"]}
    out: dict[str, dict[str, object]] = {}
    todo = [d["name"] for d in pkgs["urim"].get("dependencies", [])]
    while todo:
        name = todo.pop()
        if name in out:
            continue
        p = pkgs[name]
        out[name] = {"version": p["version"], "sdist": p["sdist"]["hash"]}
        todo += [d["name"] for d in p.get("dependencies", [])]
    return dict(sorted(out.items()))


def rust() -> dict[str, dict[str, object]]:
    meta = json.loads(subprocess.run(
        ["cargo", "metadata", "--format-version", "1", "--locked", "--offline",
         "--manifest-path", str(ROOT / "packages/rust/Cargo.toml")],
        capture_output=True, text=True, check=True).stdout)
    lock = tomllib.loads((ROOT / "packages/rust/Cargo.lock").read_text(encoding="utf-8"))
    sums = {(p["name"], p["version"]): p.get("checksum") for p in lock["package"]}
    by_id = {p["id"]: p for p in meta["packages"]}
    nodes = {n["id"]: n for n in meta["resolve"]["nodes"]}
    root = meta["resolve"]["root"]
    seen: set[str] = set()
    todo = [root]
    while todo:
        pid = todo.pop()
        if pid in seen:
            continue
        seen.add(pid)
        for dep in nodes[pid]["deps"]:
            if any(k["kind"] in (None, "build") for k in dep["dep_kinds"]):
                todo.append(dep["pkg"])
    out: dict[str, dict[str, object]] = {}
    for pid in seen - {root}:
        p = by_id[pid]
        kinds = {k for t in p["targets"] for k in t["kind"]}
        out[p["name"]] = {"version": p["version"], "checksum": sums[(p["name"], p["version"])],
                          "build_script": "custom-build" in kinds, "proc_macro": "proc-macro" in kinds}
    return dict(sorted(out.items()))


def main(argv: list[str]) -> int:
    try:
        actual = {"js": js(), "python": python(), "rust": rust()}
    except (OSError, KeyError, subprocess.CalledProcessError) as e:
        print(f"check-deps: cannot read the lockfiles: {e}", file=sys.stderr)
        return 2
    if argv == ["--write"]:
        doc = {"$comment": "Generated by scripts/check-deps --write. Every change needs human review "
                           "(CONTRIBUTING.md, Dependency policy).", **actual}
        ALLOW.write_text(json.dumps(doc, indent=2) + "\n", encoding="utf-8")
        print(f"check-deps: wrote {ALLOW.relative_to(ROOT)}")
        return 0
    want = json.loads(ALLOW.read_text(encoding="utf-8"))
    bad = []
    for eco, got in actual.items():
        exp = want.get(eco, {})
        for name in sorted(set(got) | set(exp)):
            if name not in exp:
                bad.append(f"{eco}: {name} {got[name]['version']} is not in the allowlist")
            elif name not in got:
                bad.append(f"{eco}: {name} is allowlisted but no longer locked (run --write)")
            elif got[name] != exp[name]:
                bad.append(f"{eco}: {name} changed: allowlist {exp[name]} != lock {got[name]}")
    scripts = js_install_scripts()
    if scripts:
        bad.append(f"js: packages with install scripts in package-lock.json: {scripts}")
    for b in bad:
        print(f"check-deps: {b}", file=sys.stderr)
    if bad:
        return 1
    build = [n for n, p in actual["rust"].items() if p["build_script"] or p["proc_macro"]]
    print(f"check-deps OK: runtime closure js {len(actual['js'])}, python {len(actual['python'])}, "
          f"rust {len(actual['rust'])} (build-time code: {', '.join(build)}); no npm install scripts")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
