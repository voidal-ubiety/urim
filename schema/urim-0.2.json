              "native",
              "portable"
            ]
          },
          "req": true
        },
        {
          "name": "objective",
          "type": {
            "k": "one",
            "keys": [
              {
                "name": "min_precision",
                "type": {
                  "k": "num",
                  "min": 0,
                  "max": 1,
                  "min_open": true
                }
              },
              {
                "name": "escalation_rate",
                "type": {
                  "k": "num",
                  "min": 0,
                  "max": 1
                }
              }
            ]
          },
          "req": true
        },
        {
          "name": "action",
          "type": {
            "k": "str",
            "fmt": "id"
          },
          "req": true
        },
        {
          "name": "else",
          "type": {
            "k": "str",
            "fmt": "id"
          }
        },
        {
          "name": "on_error",
          "type": {
            "k": "str",
            "fmt": "id"
          }
        }
      ]
    },
    "confidence_block": {
      "k": "obj",
      "fields": [
        {
          "name": "portable",
          "type": {
            "k": "enum",
            "values": [
              "top_probability",
              "margin",
              "margin_squared",
              "one_minus_entropy",
              "normalized_top"
            ]
          },
          "req": true
        }
      ]
    },
    "eval_block": {
      "k": "obj",
      "fields": [
        {
          "name": "dataset",
          "type": {
            "k": "str",
            "fmt": "string"
          },
          "req": true
        },
        {
          "name": "dataset_hash",
          "type": {
            "k": "str",
            "fmt": "hash"
          },
          "req": true
        },
        {
          "name": "min_cases",
          "type": {
            "k": "int",
            "min": 1
          },
          "req": true
        },
        {
          "name": "repeats",
          "type": {
            "k": "int",
            "min": 1
          }
        },
        {
          "name": "paraphrases",
          "type": {
            "k": "map",
            "key": "id",
            "value": {
              "k": "list",
              "items": {
                "k": "str",
                "fmt": "string"
              },
              "min": 1
            },
            "min": 1
          }
        },
        {
          "name": "accept",
          "type": {
            "k": "map",
            "key": "id",
            "value": {
              "k": "str",
              "fmt": "expr"
            },
            "min": 1
          },
          "req": true
        }
      ]
    },
    "lock_in_ack": {
      "k": "obj",
      "fields": [
        {
          "name": "extension",
          "type": {
            "k": "str",
            "fmt": "x_key"
          },
          "req": true
        },
        {
          "name": "locks_out",
          "type": {
            "k": "list",
            "items": {
              "k": "str",
              "fmt": "target_id"
            },
            "min": 1,
            "unique": true
          },
          "req": true
        },
        {
          "name": "reason",
          "type": {
            "k": "str",
            "fmt": "string"
          },
          "req": true
        }
      ]
    },
    "contract": {
      "k": "obj",
      "ext": true,
      "fields": [
        {
          "name": "urim",
          "type": {
            "k": "str",
            "fmt": "protocol_version"
          },
          "req": true
        },
        {
          "name": "contract",
          "type": {
            "k": "str",
            "fmt": "id"
          },
          "req": true
        },
        {
          "name": "version",
          "type": {
            "k": "str",
            "fmt": "semver"
          },
          "req": true
        },
        {
          "name": "description",
          "type": {
            "k": "str",
            "fmt": "string"
          }
        },
        {
          "name": "state",
          "type": {
            "k": "map",
            "key": "id",
            "value": {
              "ref": "state_field"
            },
            "min": 1
          },
          "req": true
        },
        {
          "name": "questions",
          "type": {
            "k": "map",
            "key": "id",
            "value": {
              "ref": "question"
            },
            "min": 1
          },
          "req": true
        },
        {
          "name": "policy",
          "type": {
            "k": "map",
            "key": "id",
            "value": {
              "ref": "policy_rule"
            },
            "min": 1
          }
        },
        {
          "name": "confidence",
          "type": {
            "ref": "confidence_block"
          }
        },
        {
          "name": "eval",
          "type": {
            "ref": "eval_block"
          }
        },
        {
          "name": "targets",
          "type": {
            "k": "list",
            "items": {
              "k": "str",
              "fmt": "target_id"
            },
            "min": 1,
            "unique": true
          }
        },
        {
          "name": "targets_query",
          "type": {
            "k": "str",
            "fmt": "expr"
          }
        },
        {
          "name": "requires",
          "type": {
            "k": "map",
            "key": "capability_path",
            "value": {
              "ref": "constraint"
            },
            "min": 1
          }
        },
        {
          "name": "prefers",
          "type": {
            "k": "map",
            "key": "capability_path",
            "value": {
              "ref": "preference"
            },
            "min": 1
          }
        },
        {
          "name": "accept_lock_in",
          "type": {
            "k": "list",
            "items": {
              "ref": "lock_in_ack"
            },
            "min": 1
          }
        },
        {
          "name": "selection",
          "type": {
            "k": "enum",
            "values": [
              "strict",
              "available"
            ]
          }
        },
        {
          "name": "atomic",
          "type": {
            "k": "bool"
          }
        }
      ],
      "removed": {
        "required_capabilities": "is not a urim 0.2 key: rewrite it as requires and prefers (SPEC §5.10.4) with the migration command (proposed name: urim migrate)",
        "fallbacks": "is not a urim 0.2 key: rewrite it as prefers fallbacks (SPEC §5.10.4) with the migration command (proposed name: urim migrate)"
      }
    },
    "feature_outcome": {
      "k": "alt",
      "options": [
        {
          "k": "enum",
          "values": [
            "native"
          ]
        },
        {
          "k": "obj",
          "fields": [
            {
              "name": "outcome",
              "type": {
                "k": "enum",
                "values": [
                  "emulated",
                  "dropped"
                ]
              },
              "req": true
            },
            {
              "name": "declared",
              "type": {
                "k": "enum",
                "values": [
                  "requires",
                  "prefers"
                ]
              },
              "req": true
            }
          ],
          "tag": {
            "field": "outcome",
            "variants": {
              "emulated": [
                {
                  "name": "via",
                  "type": {
                    "k": "str",
                    "fmt": "id"
                  },
                  "req": true
                }
              ],
              "dropped": []
            }
          }
        }
      ]
    },
    "extension_outcome": {
      "k": "obj",
      "fields": [
        {
          "name": "outcome",
          "type": {
            "k": "enum",
            "values": [
              "applied",
              "dropped",
              "emulated"
            ]
          },
          "req": true
        },
        {
          "name": "effect",
          "type": {
            "k": "enum",
            "values": [
              "transport",
              "behavioral"
            ]
          },
          "req": true
        }
      ],
      "tag": {
        "field": "outcome",
        "variants": {
          "applied": [
            {
              "name": "schema_hash",
              "type": {
                "k": "str",
                "fmt": "hash"
              },
              "req": true
            }
          ],
          "dropped": [],
          "emulated": []
        }
      }
    },
    "resolution": {
      "k": "obj",
      "fields": [
        {
          "name": "source",
          "type": {
            "k": "enum",
