{
  "$comment": "Single source for the urim 0.2 contract and hoshen 2 lockfile schemas (SPEC.md §5.1.2, §5.10, §5.11, §6.2). scripts/gen-schema turns this into packages/js/src/schema.gen.ts, packages/python/src/urim/schema_gen.py and packages/rust/src/schema_gen.rs; verify.sh fails if they drift. Node kinds: str (fmt), int, num, bool, enum, list, map, obj, one, alt, opaque, and ref to a named type.",
  "protocol": "0.2",
  "experimental_question_types": [
    "box",
    "extract"
  ],
  "emulations": {
    "limits.max_questions_per_request": [
      "split"
    ],
    "refusal.typed": [
      "map_error"
    ]
  },
  "formats": {
    "string": "a non-empty string",
    "expr": "a non-empty expression string",
    "id": "an id (a lowercase letter, then up to 63 of a-z, 0-9, _ and -)",
    "target_id": "a target id (<provider>/<model>, each an id)",
    "capability_path": "a capability path (dot-separated ids)",
    "semver": "a SemVer version",
    "semver_range": "a SemVer range",
    "protocol_version": "a protocol version (\"MAJOR.MINOR\")",
    "hash": "a hash (sha256:<64 lowercase hex digits>)",
    "integrity": "an integrity value (sha256-<base64 of 32 bytes>)",
    "timestamp": "an RFC 3339 timestamp with an offset",
    "x_key": "an extension key (x-<provider>)",
    "confidence_ref": "native or portable/<definition>"
  },
  "types": {
    "fallback": {
      "k": "alt",
      "options": [
        {
          "k": "enum",
          "values": [
            "drop",
            "fail"
          ]
        },
        {
          "k": "obj",
          "fields": [
            {
              "name": "emulate",
              "type": {
                "k": "str",
                "fmt": "id"
              },
              "req": true
            }
          ]
        }
      ]
    },
    "constraint": {
      "k": "alt",
      "options": [
        {
          "k": "str",
          "fmt": "expr"
        },
        {
          "k": "one",
          "keys": [
            {
              "name": "includes",
              "type": {
                "k": "list",
                "items": {
                  "k": "str",
                  "fmt": "string"
                },
                "min": 1
              }
            },
            {
              "name": "any_of",
              "type": {
                "k": "list",
                "items": {
                  "k": "str",
                  "fmt": "string"
                },
                "min": 1
              }
            }
          ],
          "forbid": {
            "fallback": "takes no fallback: requires is hard, so a feature with a fallback belongs in prefers (SPEC §5.10.2 rule 5)"
          }
        }
      ]
    },
    "preference": {
      "k": "obj",
      "fields": [
        {
          "name": "value",
          "type": {
            "ref": "constraint"
          }
        },
        {
          "name": "fallback",
          "type": {
            "ref": "fallback"
          },
          "req": true
        }
      ]
    },
    "extension": {
      "k": "obj",
      "fields": [
        {
          "name": "fallback",
          "type": {
            "ref": "fallback"
          }
        },
        {
          "name": "with",
          "type": {
            "k": "opaque"
          },
          "req": true
        }
      ]
    },
    "state_field": {
      "k": "obj",
      "fields": [
        {
          "name": "type",
          "type": {
            "k": "enum",
            "values": [
              "string",
              "markdown",
              "json",
              "image",
              "audio",
              "video"
            ]
          },
          "req": true
        },
        {
          "name": "required",
          "type": {
            "k": "bool"
          }
        },
        {
          "name": "max_bytes",
          "type": {
            "k": "int",
            "min": 1
          }
        }
      ],
      "tag": {
        "field": "type",
        "variants": {
          "json": [
            {
              "name": "schema",
              "type": {
                "k": "opaque"
              }
            }
          ]
        }
      }
    },
    "question": {
      "k": "obj",
      "ext": true,
      "fields": [
        {
          "name": "type",
          "type": {
            "k": "enum",
            "values": [
              "choice",
              "score",
              "yesno",
              "box",
              "extract"
            ]
          },
          "req": true
        },
        {
          "name": "instructions",
          "type": {
            "k": "str",
            "fmt": "string"
          },
          "req": true
        }
      ],
      "tag": {
        "field": "type",
        "variants": {
          "choice": [
            {
              "name": "options",
              "type": {
                "k": "map",
                "key": "id",
                "value": {
                  "k": "str",
                  "fmt": "string"
                },
                "min": 1
              },
              "req": true
            }
          ],
          "score": [
            {
              "name": "levels",
              "type": {
                "k": "list",
                "items": {
                  "k": "str",
                  "fmt": "string"
                },
                "min": 2
              },
              "req": true
            }
          ],
          "yesno": [
            {
              "name": "yes",
              "type": {
                "k": "str",
                "fmt": "string"
              }
            },
            {
              "name": "no",
              "type": {
                "k": "str",
                "fmt": "string"
              }
            }
          ]
        }
      }
    },
    "policy_rule": {
      "k": "obj",
      "fields": [
        {
          "name": "question",
          "type": {
            "k": "str",
            "fmt": "id"
          },
          "req": true
        },
        {
          "name": "when",
          "type": {
            "k": "obj",
            "fields": [
              {
                "name": "answer",
                "type": {
                  "k": "str",
                  "fmt": "string"
                },
