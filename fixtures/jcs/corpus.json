{
 "comment": "Golden RFC 8785 corpus (C-098). Each yaml is parsed by the port's own profile parser, then canonicalized; `error: non_finite` means canonicalization must fail. Integers are canonicalized as doubles (SPEC §13 item 5 is open). scripts/check-jcs-corpus cross-checks the jcs strings against the rfc8785 package; the port tests read this file.",
 "cases": [
  {
   "name": "zero",
   "yaml": "v: 0",
   "jcs": "{\"v\":0}"
  },
  {
   "name": "negative-zero",
   "yaml": "v: -0.0",
   "jcs": "{\"v\":0}"
  },
  {
   "name": "one",
   "yaml": "v: 1",
   "jcs": "{\"v\":1}"
  },
