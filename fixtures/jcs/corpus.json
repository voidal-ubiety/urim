   "jcs": "{\"v\":0.000001}"
  },
  {
   "name": "float-1e-7",
   "yaml": "v: 1e-7",
   "jcs": "{\"v\":1e-7}"
  },
  {
   "name": "float-negative-small",
   "yaml": "v: -1.5e-10",
   "jcs": "{\"v\":-1.5e-10}"
  },
  {
   "name": "float-denormal-min",
   "yaml": "v: 5e-324",
   "jcs": "{\"v\":5e-324}"
  },
  {
   "name": "float-max",
   "yaml": "v: 1.7976931348623157e308",
