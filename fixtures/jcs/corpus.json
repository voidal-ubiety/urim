  },
  {
   "name": "float-mantissa-one-digit",
   "yaml": "v: 2e25",
   "jcs": "{\"v\":2e+25}"
  },
  {
   "name": "hex-int",
   "yaml": "v: 0x1F",
   "jcs": "{\"v\":31}"
  },
  {
   "name": "octal-int",
   "yaml": "v: 0o17",
   "jcs": "{\"v\":15}"
  },
  {
   "name": "true",
   "yaml": "v: true",
   "jcs": "{\"v\":true}"
  },
  {
   "name": "false",
