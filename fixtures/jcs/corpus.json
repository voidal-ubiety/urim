   "jcs": "{\"v\":[]}"
  },
  {
   "name": "nested",
   "yaml": "v: {b: [1, {d: x, c: y}], a: null}",
   "jcs": "{\"v\":{\"a\":null,\"b\":[1,{\"c\":\"y\",\"d\":\"x\"}]}}"
  },
  {
   "name": "key-order-ascii",
   "yaml": "{b: 1, a: 2, aa: 3, B: 4, \"\": 5}",
   "jcs": "{\"\":5,\"B\":4,\"a\":2,\"aa\":3,\"b\":1}"
  },
  {
   "name": "key-order-utf16",
   "yaml": "{\"\\uE000\": 1, \"\\U0001F600\": 2, \"\\u00e9\": 3, z: 4}",
