  },
  {
   "name": "string-controls",
   "yaml": "v: \"\\x01\\x1f\\x7f\"",
   "jcs": "{\"v\":\"\\u0001\\u001f\"}"
  },
  {
   "name": "string-non-ascii",
   "yaml": "v: \"é 名前 \\U0001F600\"",
   "jcs": "{\"v\":\"é 名前 😀\"}"
  },
  {
   "name": "string-slash",
   "yaml": "v: a/b",
   "jcs": "{\"v\":\"a/b\"}"
  },
  {
   "name": "string-line-separator",
   "yaml": "v: \"\\u2028\\u2029\"",
   "jcs": "{\"v\":\"  \"}"
  },
  {
   "name": "infinity",
   "yaml": "v: .inf",
   "error": "non_finite"
  },
  {
   "name": "negative-infinity",
   "yaml": "v: -.inf",
   "error": "non_finite"
  },
  {
   "name": "nan",
   "yaml": "v: .nan",
   "error": "non_finite"
  },
  {
   "name": "sequence-infinite",
   "yaml": "a: [1, .inf]",
   "error": "non_finite"
  }
 ]
