{
  "name": "urim",
  "version": "0.0.1",
  "description": "Urim: a contract language for decision models. v0.0.1 ships `urim check` for contracts and hoshen lockfiles.",
  "keywords": [
    "decision-models",
    "contracts",
    "lockfile",
    "llm",
    "urim"
  ],
  "homepage": "https://urim.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voidal-ubiety/urim.git",
    "directory": "packages/js"
  },
  "bugs": {
    "url": "https://github.com/voidal-ubiety/urim/issues"
  },
  "license": "Apache-2.0",
  "author": "David Thomason",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "urim": "dist/cli.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test --test-reporter=dot test/*.test.mjs",
    "coverage": "npm run build && c8 node --test --test-reporter=dot test/*.test.mjs",
    "prepack": "npm run build",
    "lint": "tsc -p tsconfig.json --noEmit && biome ci .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "^22.20.5",
    "c8": "^10.1.3",
    "typescript": "^5.6.0"
  }
}
